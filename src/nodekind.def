// lhs = left node ID
// rhs = right node ID
WRAP(ND_ADD)
// lhs = index in nextra 
//     nextra[0] = children stmts count
//     nextra[1] = yield value node ID (0 for none)
//     nextra[2, ...] = children node IDs
// rhs = unused
WRAP(ND_BLOCK)
// lhs = child node ID
// rhs = unused
WRAP(ND_COMP)
// lhs = child node ID
// rhs = unused
WRAP(ND_EXPRSTMT)
// lhs = ident token ID
// rhs = type node ID
WRAP(ND_FIELD)
// lhs = index in nextra
//     nextra[0] = param count
//     nextra[1] = return type node ID
//     nextra[2] = body block node ID
//     nextra[3, ...] = param node IDs
// rhs = ident token ID
WRAP(ND_FNDECL)
// lhs = index in srcfiles
// rhs = path token ID
WRAP(ND_IMPORT)
// lhs = intlit token ID
// rhs = unused
WRAP(ND_INTLIT)
// lhs = ident token ID
// rhs = type node ID
WRAP(ND_PARAM)
// lhs = index in nextra where IDs of children are stored sequentially
// rhs = child count
WRAP(ND_ROOT)
// lhs = strlit token ID
// rhs = unused
WRAP(ND_STRLIT)
// lhs = index in nextra where IDs of children are stored sequentially
// rhs = child count
WRAP(ND_STRUCT)
// lhs = left node ID
// rhs = right node ID
WRAP(ND_SUB)
// lhs = ident token ID
// rhs = unused
WRAP(ND_SYM)
// lhs = index in nextra
//     nextra[0] = mut/imm keyword token ID
//     nextra[1] = type node ID
//     nextra[2] = init node ID
// rhs = ident token ID
WRAP(ND_VARDECL)
WRAP(ND_LEN)

